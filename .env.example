# =================================================================
# Sukoon — Environment Variables (PLACEHOLDERS ONLY)
# =================================================================
# Copy to `.env.local` locally. Set the same names in Vercel.
# ONE Vercel project = storefront + dashboard.
# Never commit real secrets. Never prefix private keys with NEXT_PUBLIC_.

# --- Supabase (database + admin auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apply SQL in Supabase SQL Editor (in order), including:
#   supabase/migrations/20260813120000_cod_orders_inventory.sql
#   supabase/migrations/20260813124500_checkout_shipping_area.sql
# (COD orders + Dhaka shipping areas). SUPABASE_SERVICE_ROLE_KEY is SERVER-ONLY.

# --- Cloudinary (product media) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Optional build ---
BUILD_STANDALONE=false

