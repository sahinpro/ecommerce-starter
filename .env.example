# =================================================================
# Sukoon — Environment Variables
# =================================================================
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Never commit `.env.local` or real secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.


# =================================================================
# Supabase (database + storage)
# =================================================================
# Project: https://supabase.com/dashboard/project/cdjchjjitltwkqxcwwin
# Keys: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://cdjchjjitltwkqxcwwin.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# =================================================================
# Clerk (authentication)
# =================================================================
# Leave empty to use Clerk keyless mode in development.
# Dashboard: https://dashboard.clerk.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# Where to send users after auth
# Storefront customers → /
# Admin staff → /dashboard/overview
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/


# =================================================================
# Clerk Webhooks (optional — billing / profile sync)
# =================================================================
# Clerk Dashboard → Webhooks → Signing Secret

WEBHOOK_SECRET=


# =================================================================
# Build Configuration
# =================================================================
# Set to true for Docker / VPS standalone builds

BUILD_STANDALONE=false


# =================================================================
# Sentry (optional — error tracking)
# =================================================================
# Set NEXT_PUBLIC_SENTRY_DISABLED=true to skip Sentry in local dev

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DISABLED=true
